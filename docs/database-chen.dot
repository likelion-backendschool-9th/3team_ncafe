graph ncafe_chen {
  graph [layout=neato, overlap=true, splines=line, bgcolor="white", pad="0.35", outputorder=edgesfirst];
  node [fontname="NanumSquare Neo", fontsize=19, color="#536778", penwidth=1.6, style=filled, fillcolor="white", pin=true];
  edge [fontname="NanumSquare Neo", fontsize=14, color="#617486", penwidth=1.5];

  users [shape=box, label="User", pos="250,850!", width=1.8, height=0.7, fillcolor="#dcebf4"];
  music_requests [shape=box, label="Song", pos="250,250!", width=2.0, height=0.7, fillcolor="#e9e1f3"];
  orders [shape=box, label="Order", pos="850,600!", width=1.8, height=0.7, fillcolor="#f5e0df"];
  order_items [shape=box, label="OrderItem", pos="1450,600!", width=2.1, height=0.7, fillcolor="#f5e0df"];
  cart_items [shape=box, label="CartItem", pos="1450,1100!", width=2.1, height=0.7, fillcolor="#f7e8d7"];
  menus [shape=box, label="Menu", pos="1950,900!", width=1.8, height=0.7, fillcolor="#e5f1df"];
  categories [shape=box, label="Category", pos="2600,900!", width=2.0, height=0.7, fillcolor="#e5f1df"];
  music_box_state [shape=box, label="MusicBoxState", pos="660,1360!", width=2.4, height=0.7, fillcolor="#e9e1f3"];

  node [shape=diamond, fontsize=14, height=0.82, width=1.55, fillcolor="#fffaf0"];
  submits [label="신청", pos="250,550!"];
  places [label="주문", pos="550,700!"];
  order_contains [label="포함", pos="1150,600!"];
  source_of [label="메뉴 참조", pos="1700,720!", width=1.8];
  holds [label="담음", pos="850,1050!"];
  cart_menu_reference [label="담김", pos="1700,1050!", width=1.7];
  classifies [label="분류", pos="2250,900!"];

  users -- submits [label="1"];
  submits -- music_requests [label="N"];
  users -- places [label="1"];
  places -- orders [label="N"];
  orders -- order_contains [label="1"];
  order_contains -- order_items [label="1..N"];
  order_items -- source_of [label="N"];
  source_of -- menus [label="1"];
  users -- holds [label="1"];
  holds -- cart_items [label="N"];
  cart_items -- cart_menu_reference [label="N"];
  cart_menu_reference -- menus [label="1"];
  categories -- classifies [label="1"];
  classifies -- menus [label="N"];

  node [shape=ellipse, fontsize=14, penwidth=1.1, color="#a1acb6", fillcolor="#fffefa", height=0.5, width=1.2];
  user_id [label=<<U>식별자</U>>, pos="100,1010!"];
  user_email [label="이메일", pos="20,890!"];
  user_name [label="이름", pos="20,790!"];
  user_role [label="역할", pos="100,670!"];
  user_status [label="계정 상태", pos="370,1010!", width=1.55];
  user_created [label="생성 시각", pos="-130,1010!", width=1.5];
  user_updated [label="수정 시각", pos="-130,700!", width=1.5];

  music_id [label=<<U>식별자</U>>, pos="100,100!"];
  music_requester [label="신청자명", pos="250,90!", width=1.55];
  music_title [label="곡명", pos="420,160!"];
  music_artist [label="가수", pos="470,270!"];
  music_story [label="사연", pos="390,390!"];
  music_status [label="신청곡 상태", pos="230,410!", width=1.7];
  music_video [label="유튜브 영상 ID", pos="40,370!", width=2.0];
  music_order [label="대기열 순서", pos="10,240!", width=1.7];
  music_duration [label="영상 길이(초)", pos="40,480!", width=1.8];
  music_started [label="재생 시작 시각", pos="460,480!", width=1.9];
  music_created [label="생성 시각", pos="540,60!", width=1.5];
  music_updated [label="수정 시각", pos="620,300!", width=1.5];

  order_id [label=<<U>식별자</U>>, pos="720,790!"];
  order_customer [label="주문 당시 고객명", pos="890,810!", width=2.2];
  order_status [label="주문 상태", pos="990,720!", width=1.6];
  order_type [label="매장/포장", pos="1060,850!", width=1.6];
  order_payment_method [label="카운터 결제수단", pos="1080,960!", width=2.15];
  order_request [label="요청사항", pos="700,960!", width=1.5];
  order_total [label="주문 총액", pos="900,420!", width=1.6];
  order_created [label="생성 시각", pos="700,250!", width=1.5];
  order_updated [label="수정 시각", pos="930,250!", width=1.5];

  order_item_id [label=<<U>식별자</U>>, pos="1330,790!"];
  order_item_name [label="주문 당시 메뉴명", pos="1500,800!", width=2.35];
  order_item_image [label="주문 당시 이미지 주소", pos="1630,300!", width=2.7];
  order_item_temperature [label="온도", pos="1610,480!"];
  order_item_qty [label="수량", pos="1430,410!"];
  order_item_price [label="주문 당시 단가", pos="1250,420!", width=1.9];
  order_item_total [label="항목 합계", pos="1090,430!", width=1.6];

  cart_item_id [label=<<U>식별자</U>>, pos="1450,1270!"];
  cart_item_qty [label="수량", pos="1280,1220!"];
  cart_item_temperature [label="온도", pos="1640,1210!", width=1.2];
  cart_item_created [label="생성 시각", pos="1190,1390!", width=1.5];
  cart_item_updated [label="수정 시각", pos="1460,1430!", width=1.5];

  menu_id [label=<<U>식별자</U>>, pos="1820,1050!"];
  menu_slug [label="슬러그", pos="1790,1170!"];
  menu_name [label="메뉴명", pos="1950,1210!"];
  menu_image [label="메뉴 이미지 주소", pos="2300,1110!", width=2.15];
  menu_description [label="설명", pos="2300,1010!"];
  menu_price [label="가격", pos="2240,750!"];
  menu_available [label="판매 가능 여부", pos="2160,680!", width=1.95];
  menu_supports_hot [label="HOT 제공 여부", pos="1870,620!", width=1.9];
  menu_supports_iced [label="ICED 제공 여부", pos="2010,620!", width=1.9];
  menu_is_new [label="첫 개시 표시 여부", pos="1870,1350!", width=2.25];
  menu_recommended [label="추천 표시 여부", pos="2130,1350!", width=2.0];
  menu_created [label="생성 시각", pos="2350,1470!", width=1.5];
  menu_updated [label="수정 시각", pos="2420,1300!", width=1.5];

  category_id [label=<<U>식별자</U>>, pos="2600,1080!"];
  category_name [label="카테고리명", pos="2790,970!", width=1.85];
  category_order [label="표시 순서", pos="2790,830!", width=1.6];
  category_fallback [label="기타 카테고리 여부", pos="2600,710!", width=2.4];
  category_created [label="생성 시각", pos="2750,1230!", width=1.5];
  category_updated [label="수정 시각", pos="2900,1100!", width=1.5];

  music_box_state_id [label=<<U>식별자 1</U>>, pos="480,1460!", width=1.6];
  music_box_state_revision [label="변경 버전", pos="660,1500!", width=1.6];
  music_box_state_updated [label="수정 시각", pos="880,1460!", width=1.5];

  edge [color="#a8b3bd", penwidth=1.0];
  users -- {user_id user_email user_name user_role user_status user_created user_updated};
  music_requests -- {music_id music_requester music_title music_artist music_story music_status music_video music_order music_duration music_started music_created music_updated};
  orders -- {order_id order_customer order_status order_type order_payment_method order_request order_total order_created order_updated};
  order_items -- {order_item_id order_item_name order_item_image order_item_temperature order_item_qty order_item_price order_item_total};
  cart_items -- {cart_item_id cart_item_qty cart_item_temperature cart_item_created cart_item_updated};
  menus -- {menu_id menu_slug menu_name menu_image menu_description menu_price menu_available menu_supports_hot menu_supports_iced menu_is_new menu_recommended menu_created menu_updated};
  categories -- {category_id category_name category_order category_fallback category_created category_updated};
  music_box_state -- {music_box_state_id music_box_state_revision music_box_state_updated};
}
