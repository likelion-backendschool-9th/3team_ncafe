digraph ncafe_erd {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.55", ranksep="0.9", splines=polyline, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [dir=none, color="#8795a1", penwidth=1.5, fontname="Arial", fontsize=10, fontcolor="#536270", labeldistance=1.4];

  users [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#dcebf4"><B>users</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">UK  email</TD></TR>
      <TR><TD ALIGN="LEFT">name · password_hash</TD></TR>
      <TR><TD ALIGN="LEFT">role · status</TD></TR>
    </TABLE>
  >];
  categories [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#e5f1df"><B>categories</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">UK  name</TD></TR>
      <TR><TD ALIGN="LEFT">display_order · is_system</TD></TR>
    </TABLE>
  >];
  menus [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#e5f1df"><B>menus</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  category_id</TD></TR>
      <TR><TD ALIGN="LEFT">UK  slug</TD></TR>
      <TR><TD ALIGN="LEFT">name · price · available</TD></TR>
      <TR><TD ALIGN="LEFT">archived_at · hot · ice</TD></TR>
    </TABLE>
  >];
  carts [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#f7e8d7"><B>carts</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK, FK  user_id</TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD></TR>
    </TABLE>
  >];
  cart_items [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#f7e8d7"><B>cart_items</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  cart_user_id · menu_id</TD></TR>
      <TR><TD ALIGN="LEFT">temperature · quantity</TD></TR>
      <TR><TD ALIGN="LEFT">selected</TD></TR>
    </TABLE>
  >];
  orders [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#f5e0df"><B>orders</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  customer_id</TD></TR>
      <TR><TD ALIGN="LEFT">status · total_amount</TD></TR>
      <TR><TD ALIGN="LEFT">cancellation_reason</TD></TR>
    </TABLE>
  >];
  order_items [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#f5e0df"><B>order_items</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  order_id · menu_id</TD></TR>
      <TR><TD ALIGN="LEFT">menu_name · unit_price</TD></TR>
      <TR><TD ALIGN="LEFT">quantity · line_total</TD></TR>
    </TABLE>
  >];
  order_status_events [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#f5e0df"><B>order_status_events</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  order_id · actor_user_id</TD></TR>
      <TR><TD ALIGN="LEFT">from_status · to_status</TD></TR>
    </TABLE>
  >];
  music_requests [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#e9e1f3"><B>music_requests</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  user_id</TD></TR>
      <TR><TD ALIGN="LEFT">status · playlist_order</TD></TR>
      <TR><TD ALIGN="LEFT">started_at · duration_seconds</TD></TR>
    </TABLE>
  >];
  music_box_state [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#5c6f7f">
      <TR><TD BGCOLOR="#e9e1f3"><B>music_box_state</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id = 1</TD></TR>
      <TR><TD ALIGN="LEFT">revision</TD></TR>
    </TABLE>
  >];

  users -> carts [taillabel="1", headlabel="0..1"];
  users -> orders [taillabel="1", headlabel="0..N"];
  users -> music_requests [taillabel="1", headlabel="0..N"];
  users -> order_status_events [taillabel="1", headlabel="0..N"];
  categories -> menus [taillabel="1", headlabel="0..N"];
  carts -> cart_items [taillabel="1", headlabel="0..N"];
  menus -> cart_items [taillabel="1", headlabel="0..N"];
  orders -> order_items [taillabel="1", headlabel="1..N"];
  menus -> order_items [taillabel="1", headlabel="0..N"];
  orders -> order_status_events [taillabel="1", headlabel="1..N"];
}
