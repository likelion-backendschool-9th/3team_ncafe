# Local mock session signing key. Generate with: openssl rand -base64 32
MOCK_SESSION_SECRET=replace-with-a-long-random-value

# Server-only key for the current story's Typecast narration.
TYPECAST_API_KEY=replace-with-your-typecast-api-key

# Spring Boot backend origin used by server-side API requests.
API_ORIGIN=http://localhost:8080
